<!-- Tank's ClickHouse (HLD §7.1): exchange market series and prints. Memory and caches are
     ClickHouse's defaults for the host; none of the system log tables, which would otherwise grow. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <size>50M</size>
        <count>3</count>
    </logger>
    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <session_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <crash_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <processors_profile_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>
    <blob_storage_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
</clickhouse>
