# Nonsecret values only. Place actual secret files outside this repository.
TANK_SECRETS_DIR=/srv/tank-secrets
TANK_CONFIG_PATH=./config
OPENMA_SOURCE_PATH=/srv/open-managed-agents
TANK_BACKUP_PATH=/mnt/external/tank-backup
TANK_SANDBOX_IMAGE=tank-analysis:python3.12-local
TANK_SANDBOX_OCI_PATH=/srv/tank-sandbox-oci
KVM_GID=REPLACE_WITH_STAT_DEV_KVM_GROUP_ID
TANK_USER_AGENT=TankV0/1.0 contact=REPLACE_WITH_EMAIL
TANK_X_ENABLED=false
TANK_TELEGRAM_ALERTS_CHAT=
TANK_TELEGRAM_OPS_CHAT=

# Choose an unused private Compose CIDR; use the actual observed VM source CIDR.
TANK_COMPOSE_CIDR=REPLACE_WITH_COMPOSE_CIDR
TANK_PG_HBA_PATH=/srv/tank-network/pg_hba.conf
# Passed to prepare_network.py, not interpreted by Compose:
# Reobserve after an OpenMA endpoint change; regenerate HBA and reload PostgreSQL.
TANK_SANDBOX_CIDR=REPLACE_WITH_OBSERVED_VM_SOURCE_CIDR

# Jev uses the openrouter_api_key secret, with pinned model jev-1.13.
# Analyst models continue through the Codex subscription gateway.

# Set the private list ID in config/sources.yaml S29.list_id.
# To enable X explicitly, add -f compose.x.yaml with x_session.

# Measured on the dedicated Apple Silicon nested-KVM installation; native SDK otherwise defaults to 2.
TANK_SANDBOX_CPUS=2
