17 3 * * * root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin flock /run/lock/tank-grafana-nginx.lock sh -c 'test ! -e /var/lib/tank-grafana-nginx/transaction.json && certbot renew --cert-name @HOST@ --quiet --config-dir /var/lib/tank-grafana-nginx/certbot/config --work-dir /var/lib/tank-grafana-nginx/certbot/work --logs-dir /var/lib/tank-grafana-nginx/certbot/logs && nginx -t && systemctl reload nginx'
