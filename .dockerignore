# Only the application, locked dependencies and operational deployment assets are
# needed by the main image. Tests, evidence, captures and local checkouts stay out.
**
!Dockerfile
!pyproject.toml
!uv.lock
!src/
!src/**
!deploy/
!deploy/**

# Exclusions still apply inside the allowed trees.
**/.git
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/node_modules
**/.venv
**/.env
**/.env.*
**/auth.json
**/*storage-state*.json
**/secrets/**
deploy/generated
deploy/operator.env
