{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@open-managed-agents/managed-runtime-boxlite": [
        "../../vendor/openma/packages/managed-runtime-boxlite/src/guest-filesystem.ts"
      ]
    }
  },
  "include": [
    "*.mts",
    "../../deploy/**/*.mts",
    "../../tests/openma/**/*.mts",
    "../../vendor/openma/tank-deploy/*.mts"
  ]
}
