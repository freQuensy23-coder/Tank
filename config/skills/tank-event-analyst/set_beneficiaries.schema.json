{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "token_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "COMPETITOR",
              "LOSER"
            ]
          },
          "layer": {
            "enum": [
              "ISSUER_PRODUCT",
              "VENUE_DEX",
              "SETTLEMENT_L1_L2",
              "LIQUIDITY_EXECUTION",
              "LENDING_COLLATERAL",
              "ORACLE_DATA",
              "INTEROPERABILITY",
              "CUSTODY_COMPLIANCE"
            ]
          },
          "direction": {
            "enum": [
              "POSITIVE",
              "NEGATIVE"
            ]
          },
          "causal_chain": {
            "type": "string"
          },
          "integration_state": {
            "enum": [
              null,
              "COMPATIBLE",
              "IN_DEVELOPMENT",
              "BUILT",
              "SUBMITTED",
              "APPROVED",
              "LIVE",
              "MATERIAL_USAGE",
              "ECONOMIC_FLOW"
            ]
          },
          "directionality": {
            "enum": [
              "SOURCE_SIDE_SUPPORT",
              "COUNTERPARTY_ADOPTION",
              "BOTH",
              "NONE"
            ]
          },
          "exposure_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "TDD §4.7 exposure rubric: 10 = sole required rail with counterparty evidence; 8 = required LIVE rail; 6 = likely rail with BUILT, SUBMITTED or APPROVED integration; 4 = compatible candidate; 2 = thematic connection; 0 = none. Supply the evidence and integration state supporting the selected level."
          },
          "edge_certainty": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "credibility_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_thesis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mechanism",
              "quote",
              "claim_ids"
            ],
            "properties": {
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": "Explicit negative economic thesis for a LOSER edge with NEGATIVE direction. Supply the causal mechanism, a verbatim supporting quote and accepted RELATION claim references; the agent judges the quoted causal evidence; Tank applies deterministic role and dependency rules using the structured fields."
          }
        },
        "required": [
          "entity_id",
          "token_id",
          "role",
          "layer",
          "direction",
          "causal_chain",
          "directionality",
          "exposure_score",
          "edge_certainty",
          "evidence"
        ]
      }
    },
    "layer_reasons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ISSUER_PRODUCT": {
          "type": "string"
        },
        "VENUE_DEX": {
          "type": "string"
        },
        "SETTLEMENT_L1_L2": {
          "type": "string"
        },
        "LIQUIDITY_EXECUTION": {
          "type": "string"
        },
        "LENDING_COLLATERAL": {
          "type": "string"
        },
        "ORACLE_DATA": {
          "type": "string"
        },
        "INTEROPERABILITY": {
          "type": "string"
        },
        "CUSTODY_COMPLIANCE": {
          "type": "string"
        }
      },
      "required": [],
      "description": "Give a reason for every layer without a credible beneficiary, including layers that contain only unverified or candidate edges."
    },
    "layer_statuses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ISSUER_PRODUCT": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "VENUE_DEX": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "SETTLEMENT_L1_L2": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "LIQUIDITY_EXECUTION": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "LENDING_COLLATERAL": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "ORACLE_DATA": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "INTEROPERABILITY": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "CUSTODY_COMPLIANCE": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        }
      }
    },
    "no_credible_secondary_reason": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "edges"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Map positive beneficiaries, competitors and losers across the eight declared economic layers. Each edge needs accepted claim references, an explicit causal or share-loss chain, integration state/directionality and exposure 0..10. Token IDs must belong to the fixed registry universe; organization relevance alone does not prove token value capture. Supply reasons and NONE/UNKNOWN status for omitted layers. Negative token theses require explicit accepted causal evidence and a verbatim quote. Persists a versioned map and returns the token analysis set and per-layer reasons."
}
