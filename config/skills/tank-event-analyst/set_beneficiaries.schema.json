{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "token_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "COMPETITOR",
              "LOSER"
            ]
          },
          "layer": {
            "enum": [
              "ISSUER_PRODUCT",
              "VENUE_DEX",
              "SETTLEMENT_L1_L2",
              "LIQUIDITY_EXECUTION",
              "LENDING_COLLATERAL",
              "ORACLE_DATA",
              "INTEROPERABILITY",
              "CUSTODY_COMPLIANCE"
            ]
          },
          "direction": {
            "enum": [
              "POSITIVE",
              "NEGATIVE"
            ]
          },
          "causal_chain": {
            "type": "string"
          },
          "integration_state": {
            "enum": [
              null,
              "COMPATIBLE",
              "IN_DEVELOPMENT",
              "BUILT",
              "SUBMITTED",
              "APPROVED",
              "LIVE",
              "MATERIAL_USAGE",
              "ECONOMIC_FLOW"
            ]
          },
          "directionality": {
            "enum": [
              "SOURCE_SIDE_SUPPORT",
              "COUNTERPARTY_ADOPTION",
              "BOTH",
              "NONE"
            ]
          },
          "exposure_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "edge_certainty": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "credibility_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "entity_id",
          "token_id",
          "role",
          "layer",
          "direction",
          "causal_chain",
          "directionality",
          "exposure_score",
          "edge_certainty",
          "evidence"
        ]
      }
    },
    "layer_reasons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ISSUER_PRODUCT": {
          "type": "string"
        },
        "VENUE_DEX": {
          "type": "string"
        },
        "SETTLEMENT_L1_L2": {
          "type": "string"
        },
        "LIQUIDITY_EXECUTION": {
          "type": "string"
        },
        "LENDING_COLLATERAL": {
          "type": "string"
        },
        "ORACLE_DATA": {
          "type": "string"
        },
        "INTEROPERABILITY": {
          "type": "string"
        },
        "CUSTODY_COMPLIANCE": {
          "type": "string"
        }
      },
      "required": []
    },
    "layer_statuses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ISSUER_PRODUCT": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "VENUE_DEX": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "SETTLEMENT_L1_L2": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "LIQUIDITY_EXECUTION": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "LENDING_COLLATERAL": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "ORACLE_DATA": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "INTEROPERABILITY": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        },
        "CUSTODY_COMPLIANCE": {
          "enum": [
            "NONE",
            "UNKNOWN"
          ]
        }
      }
    },
    "no_credible_secondary_reason": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "edges"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Rules of \u00a74.7. Returns: Analysis set (universe tokens) and per-layer reasons for none."
}
