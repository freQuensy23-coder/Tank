{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "ARM",
        "DISARM"
      ]
    },
    "cond_id": {
      "type": "string",
      "description": "DISARM only: ID of the ARMED watch condition of the current event (CND-\u2026); find it with read-only SQL (tank-data data guide, \u00abFinding record IDs for tool arguments\u00bb), \u00abWatch conditions of an event\u00bb."
    },
    "token_id": {
      "type": "string",
      "description": "ARM only: Registry token key (reg.tokens), shown after \u00ab \u00b7 \u00bb next to the name in Tank's messages and results, e.g. bitcoin:BTC in \u00abBitcoin (BTC) \u00b7 bitcoin:BTC\u00bb."
    },
    "text": {
      "type": "string",
      "maxLength": 500
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "op": {
            "enum": [
              "==",
              "!=",
              ">",
              ">=",
              "<",
              "<=",
              "in"
            ]
          },
          "value": {},
          "window": {
            "enum": [
              "W15M",
              "W1H",
              "W4H",
              "W24H"
            ]
          },
          "persist_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          }
        },
        "required": [
          "metric",
          "op",
          "value"
        ]
      }
    },
    "expires_in_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    }
  },
  "required": [
    "action"
  ]
}
