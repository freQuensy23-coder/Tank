{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_item",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "title",
            "observed_at"
          ]
        },
        {
          "required": [
            "excerpt",
            "observed_at"
          ]
        }
      ]
    }
  },
  "required": [],
  "description": "Read a displayed source document by URL and observation time; omit document to read the triggering source. Returns text, author, source and dates. Cite verbatim evidence."
}
