{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "add_observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "link": {
      "enum": [
        "CORROBORATION",
        "STATE_UPDATE",
        "DENIAL",
        "CONTRADICTION"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "subject",
          "predicate",
          "object",
          "state_claim",
          "directionality",
          "evidence_class",
          "quote"
        ],
        "properties": {
          "type": {
            "enum": [
              "FACT",
              "STATE",
              "NUMBER",
              "RELATION",
              "TIMESTAMP",
              "MECHANISM",
              "MILESTONE"
            ]
          },
          "subject": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "state_claim": {
            "type": [
              "string",
              "null"
            ]
          },
          "directionality": {
            "enum": [
              "SOURCE_SIDE_SUPPORT",
              "COUNTERPARTY_ADOPTION",
              "BOTH",
              "NONE"
            ]
          },
          "evidence_class": {
            "enum": [
              "PRIMARY_FACT",
              "SECONDARY_REPORT",
              "SOCIAL_LEAD",
              "RUMOR",
              "TECHNICAL"
            ]
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "public_at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "basis",
        "quote"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "EXACT",
            "HOUR",
            "DAY"
          ]
        },
        "basis": {
          "type": "string"
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "freshness": {
      "enum": [
        "FRESH",
        "NORMAL",
        "MEDIUM",
        "POOR",
        "OLD",
        "STALE"
      ]
    },
    "certainty": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "milestone_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "quote"
      ]
    }
  },
  "required": [
    "event_id",
    "item_id",
    "link",
    "claims",
    "public_at",
    "freshness"
  ],
  "description": "Same validators; state machine \u00a73.6. Returns: New stage, contradictions."
}
