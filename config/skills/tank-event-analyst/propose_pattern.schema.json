{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "propose_pattern",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hook": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "description": "Each entry cites one stored record by its ID: {claim_id} for a claim, {event_id} for an event or {item_id} for a source document; find them with read-only SQL (tank-data data guide, \u00abFinding record IDs for tool arguments\u00bb).",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim_id": {
                "type": "string",
                "description": "Claim ID (CLM-\u2026)."
              }
            },
            "required": [
              "claim_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "description": "Event ID (EVT-\u2026)."
              }
            },
            "required": [
              "event_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "description": "Source document ID (ITM-\u2026 or web-\u2026)."
              }
            },
            "required": [
              "item_id"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "hook",
    "subject",
    "evidence"
  ],
  "description": "Propose a reusable pattern for adversarial scout review, citing stored claims, events or source documents by ID as evidence. Returns its subject and review status."
}
