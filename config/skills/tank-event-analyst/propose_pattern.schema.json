{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "propose_pattern",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hook": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quote": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "predicate": {
                "type": "string"
              },
              "object": {
                "type": "string"
              }
            },
            "required": [
              "quote"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "statement": {
                "type": "string"
              },
              "public_at": {
                "type": "string"
              }
            },
            "required": [
              "statement"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "observed_at": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "hook",
    "subject",
    "evidence"
  ],
  "description": "Propose a reusable pattern with displayed claims or source documents as evidence. Returns its subject and review status."
}
