{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_event",
    "statement",
    "certainty",
    "certainty_reason",
    "entities",
    "tokens",
    "event_time",
    "public_at",
    "freshness",
    "claims",
    "next_milestone",
    "checked_sources"
  ],
  "properties": {
    "is_event": {
      "type": "boolean"
    },
    "statement": {
      "type": "string"
    },
    "certainty": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "description": "Agent-assigned source certainty: HIGH for an official/primary source or observed market/technical fact, MEDIUM for likely but unproven reporting, LOW for implausible or unknown/unreliable authors. Tank records it as supplied."
    },
    "certainty_reason": {
      "type": "string",
      "description": "Explain the source authority and evidence supporting the supplied certainty; Tank stores the reason without reclassifying it."
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "ACTOR",
              "COUNTERPARTY",
              "SUBJECT",
              "REGULATOR"
            ]
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "quote"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "EXACT",
            "BUCKET_1H",
            "BUCKET_1D",
            "UNKNOWN"
          ]
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "public_at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "basis",
        "quote"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "EXACT",
            "HOUR",
            "DAY"
          ]
        },
        "basis": {
          "type": "string"
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "freshness": {
      "enum": [
        "FRESH",
        "NORMAL",
        "MEDIUM",
        "POOR",
        "OLD",
        "STALE"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "subject",
          "predicate",
          "object",
          "state_claim",
          "directionality",
          "evidence_class",
          "quote",
          "verified"
        ],
        "properties": {
          "type": {
            "enum": [
              "FACT",
              "STATE",
              "NUMBER",
              "RELATION",
              "TIMESTAMP",
              "MECHANISM",
              "MILESTONE"
            ],
            "description": "Atomic claim kind. Use STATE when the verbatim quote establishes an event or integration stage and set state_claim explicitly. FACT describes a fact but FACT with state_claim null does not advance the event stage. NUMBER, RELATION, TIMESTAMP, MECHANISM and MILESTONE retain their evidence contracts."
          },
          "subject": {
            "type": "string",
            "description": "Short plain-language subject, e.g. 'OJK'. Printed on the card."
          },
          "predicate": {
            "type": "string",
            "description": "Plain-language verb phrase as it reads in a sentence, e.g. 'expects trading to start on', never snake_case. Printed on the card."
          },
          "object": {
            "type": "string",
            "description": "Short plain-language object, at most about 12 words; details stay in the quote. Printed on the card."
          },
          "state_claim": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "RUMOR",
              "PROPOSED",
              "APPROVED",
              "SIGNED",
              "DEPLOYED",
              "LIVE",
              "MONEY_FLOWING",
              "COMPATIBLE",
              "IN_DEVELOPMENT",
              "BUILT",
              "SUBMITTED",
              "MATERIAL_USAGE",
              "ECONOMIC_FLOW",
              "CANCELLED",
              "REVERSED",
              "REJECTED",
              "PAUSED",
              null
            ],
            "description": "Agent-assigned stage asserted by this claim. Use STATE for a stage assertion and the highest quote-supported stage; null is valid for unknown or non-stage claims. A proposal/request is PROPOSED; an official committed future plan is APPROVED, not deployment or live operation. One-sided compatibility, SDK or repository evidence supports at most BUILT on the integration ladder and never limits event state. Supply verified separately; Tank records both without semantic rechecking."
          },
          "directionality": {
            "enum": [
              "SOURCE_SIDE_SUPPORT",
              "COUNTERPARTY_ADOPTION",
              "BOTH",
              "NONE"
            ]
          },
          "evidence_class": {
            "enum": [
              "PRIMARY_FACT",
              "SECONDARY_REPORT",
              "SOCIAL_LEAD",
              "RUMOR",
              "TECHNICAL"
            ]
          },
          "quote": {
            "type": "string",
            "description": "Verbatim atomic quote. Cite its actual saved document through evidence; a fetched page has its own document even when its URL matches the discovery item."
          },
          "approval_dependency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "tokens",
              "claims"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "EVENT",
                  "TOKEN"
                ]
              },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "quote": {
                      "type": "string"
                    },
                    "subject": {
                      "type": "string"
                    },
                    "predicate": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string"
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "observed_at": {
                            "type": "string"
                          },
                          "excerpt": {
                            "type": "string"
                          }
                        },
                        "anyOf": [
                          {
                            "required": [
                              "url"
                            ]
                          },
                          {
                            "required": [
                              "title",
                              "observed_at"
                            ]
                          },
                          {
                            "required": [
                              "excerpt",
                              "observed_at"
                            ]
                          }
                        ]
                      }
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "stage": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "quote"
                  ]
                }
              }
            },
            "description": "Explicit model-authored thesis dependency. References must identify existing accepted causal RELATION claims; the service validates scope and project name and tickerentity and does not infer dependencies from text."
          },
          "verified": {
            "type": "boolean",
            "description": "Agent-assigned verification under claim rule V2: true only for HIGH-certainty support; LIVE or higher also needs explicit availability or a market/technical artifact. Tank stores this flag without semantic rechecking."
          },
          "verification_missing": {
            "type": [
              "string",
              "null"
            ],
            "description": "Agent-supplied explanation of what confirmation is missing for this unverified claim (for example, no announcement from the named organization). Tank preserves and displays it verbatim; null means the reason was not established. Keep it to about 10 words; it is printed in NOT VERIFIED."
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "description": "Agent-supplied exact source document containing this claim's quote. For text read with fetch_page or web_search, use that returned document, not the discovery document merely because its URL matches. The root tool document remains the trigger/origin. Tank preserves these references without semantic rewriting.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document",
                "quote"
              ],
              "properties": {
                "document": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "observed_at": {
                      "type": "string"
                    },
                    "excerpt": {
                      "type": "string"
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "url"
                      ]
                    },
                    {
                      "required": [
                        "title",
                        "observed_at"
                      ]
                    },
                    {
                      "required": [
                        "excerpt",
                        "observed_at"
                      ]
                    }
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "next_milestone": {
      "type": [
        "object",
        "null"
      ]
    },
    "checked_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timing_confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "description": "Agent-supplied confidence in the event timing: HIGH for an exact primary timestamp, MEDIUM for bucket precision, LOW for collection time only. Optional; omission leaves declared timestamp precision as the timing-confidence basis."
    }
  },
  "description": "Record the current source as a new event, or mark it as containing no new event. The host binds the triggering source and creates all stored relationships. Cite source documents by URL and observation time with verbatim quotes."
}
