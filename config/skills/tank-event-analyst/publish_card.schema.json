{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publish_card",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "PARTIAL",
        "FULL",
        "UPDATE"
      ]
    },
    "verdict": {
      "type": "string"
    },
    "why": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3
    }
  },
  "required": [
    "event_id",
    "kind",
    "verdict",
    "why"
  ]
}
