{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "merge_into",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string"
        },
        "public_at": {
          "type": "string"
        }
      },
      "required": [
        "statement"
      ]
    }
  },
  "required": [
    "event"
  ],
  "description": "Merge the current event into a displayed event selected by its exact statement and public time."
}
