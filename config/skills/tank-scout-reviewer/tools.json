[
  {
    "name": "search_tank_items",
    "description": "Search collected source items by text over at most the preceding 90 days, returning at most 20 matching source documents and excerpts. This queries stored observations without external network requests. Read the full item before citing an excerpt or deciding that two items describe the same event.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "web_search",
    "description": "Search public web text using pinned ddgs with DuckDuckGo only. Requests are spaced by at least 2 seconds; rate-limit, block and timeout failures retry after 5,15,45 seconds, then return an explicit error without another search engine. Returns up to 10 titles, URLs and snippets stored as evidence. Search snippets are discovery data; fetch the source page before using a factual quote.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "record_review",
    "description": "Record the current proposal review with scores, evidence, verdict and reason. Select an optional duplicate by its displayed subject.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quote": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "predicate": {
                    "type": "string"
                  },
                  "object": {
                    "type": "string"
                  }
                },
                "required": [
                  "quote"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "public_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "statement"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ]
              }
            ]
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overlap": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "observability": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "reusability": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "decision_value": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "overlap",
            "observability",
            "reusability",
            "decision_value"
          ]
        },
        "recommendation": {
          "enum": [
            "SUBCATEGORY",
            "TEST_MORE",
            "NEW_CATEGORY",
            "REJECT"
          ]
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "subject": {
                  "type": "string"
                }
              },
              "required": [
                "subject"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "verdict",
        "reason",
        "evidence",
        "scores",
        "recommendation"
      ]
    }
  }
]
