{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record_review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "description": "Each entry cites one stored record by its ID: {claim_id} for a claim, {event_id} for an event or {item_id} for a source document; find them with read-only SQL (your skill, \u00abFinding record IDs\u00bb).",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim_id": {
                "type": "string",
                "description": "Claim ID (CLM-\u2026)."
              }
            },
            "required": [
              "claim_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "description": "Event ID (EVT-\u2026)."
              }
            },
            "required": [
              "event_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "description": "Source document ID (ITM-\u2026 or web-\u2026)."
              }
            },
            "required": [
              "item_id"
            ]
          }
        ]
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "observability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "reusability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "decision_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "overlap",
        "observability",
        "reusability",
        "decision_value"
      ]
    },
    "recommendation": {
      "enum": [
        "SUBCATEGORY",
        "TEST_MORE",
        "NEW_CATEGORY",
        "REJECT"
      ]
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "Proposal ID (PRP-\u2026) of the earlier open proposal of the same concept, or null; find it with read-only SQL (your skill, \u00abFinding record IDs\u00bb), \u00abProposals by subject\u00bb."
    }
  },
  "required": [
    "verdict",
    "reason",
    "evidence",
    "scores",
    "recommendation"
  ],
  "description": "Record the adversarial review of the current proposal: verdict, reason, the four 0\u201310 scores and the recommendation. Cite stored claims, events or source documents by ID as evidence, and name an earlier open proposal of the same concept in duplicate_of by its proposal ID. The host binds the current proposal."
}
