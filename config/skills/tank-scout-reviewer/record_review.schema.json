{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record_review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quote": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "predicate": {
                "type": "string"
              },
              "object": {
                "type": "string"
              }
            },
            "required": [
              "quote"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "statement": {
                "type": "string"
              },
              "public_at": {
                "type": "string"
              }
            },
            "required": [
              "statement"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "observed_at": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          }
        ]
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "observability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "reusability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "decision_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "overlap",
        "observability",
        "reusability",
        "decision_value"
      ]
    },
    "recommendation": {
      "enum": [
        "SUBCATEGORY",
        "TEST_MORE",
        "NEW_CATEGORY",
        "REJECT"
      ]
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string"
            }
          },
          "required": [
            "subject"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "verdict",
    "reason",
    "evidence",
    "scores",
    "recommendation"
  ],
  "description": "Record the current proposal review with scores, evidence, verdict and reason. Select an optional duplicate by its displayed subject."
}
