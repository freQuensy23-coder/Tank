{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record_review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "observability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "reusability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "decision_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "overlap",
        "observability",
        "reusability",
        "decision_value"
      ]
    },
    "recommendation": {
      "enum": [
        "SUBCATEGORY",
        "TEST_MORE",
        "NEW_CATEGORY",
        "REJECT"
      ]
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "proposal_id",
    "verdict",
    "reason",
    "evidence",
    "scores",
    "recommendation"
  ],
  "description": "Record this proposal session's final adversarial review: all four rubric scores, recommendation, cited evidence and reason; optionally merge a semantic duplicate into an existing open proposal. Returns the persisted review/proposal. This never approves production categories or expands the token universe."
}
