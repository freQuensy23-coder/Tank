as removed. A `,_jsx(_components.code,{children:`sell`}),` side indicates an up-tick.`]}),`\n`,_jsx(Heading,{level:`2`,id:`pagination`,children:`Pagination`}),`\n`,_jsxs(_components.p,{children:[`This request is paginated. See `,_jsx(_components.a,{href:`/exchange/rest-api/pagination`,children:`Pagination`}),` for more information.`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"59:[\"$\",\"$L5f\",null,{\"slug\":\"api-reference/exchange-api/rest-api/products/get-product-trades\",\"pageMetadata\":\"$47:props:pageMetadata\",\"theme\":\"aspen\",\"children\":[\"$\",\"$L60\",null,{\"mdxSource\":{\"compiledSource\":\"$61\",\"frontmatter\":{},\"scope\":{\"pageMetadata\":{\"title\":\"Get product trades\",\"openapi\":\"GET /products/{product_id}/trades\",\"playground\":\"simple\",\"description\":\"Gets a list the latest trades for a product.\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-product-trades\"},\"config\":{}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"docs.cdp.coinbase.com\"}]}]\n"])</script></body></html>