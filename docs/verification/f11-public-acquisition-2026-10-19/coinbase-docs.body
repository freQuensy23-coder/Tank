);\n    style.id = \"scroll-gradient-styles\";\n    style.textContent = `\n      .scroll-gradient::after {\n        content: '';\n        position: absolute;\n        top: 0;\n        right: 0;\n        bottom: 0;\n        width: 40px;\n        pointer-events: none;\n        z-index: 999;\n        background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 30%, rgba(255, 255, 255, 0.6) 70%, rgba(255, 255, 255, 0.9) 100%);\n        mix-blend-mode: normal;\n        opacity: 1;\n      }\n      \n      .scroll-gradient.hide-gradient::after {\n        opacity: 0;\n      }\n      \n      /* Dark mode - use rgb(11, 12, 16) */\n      html.dark .scroll-gradient::after {\n        background: linear-gradient(90deg, rgba(11, 12, 16, 0) 0%, rgba(11, 12, 16, 0.3) 30%, rgba(11, 12, 16, 0.6) 70%, rgba(11, 12, 16, 0.9) 100%);\n      }\n      \n      /* Light mode - use white */\n      html:not(.dark) .scroll-gradient::after {\n        background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 30%, rgba(255, 255, 255, 0.6) 70%, rgba(255, 255, 255, 0.9) 100%);\n      }\n    `;\n    document.head.appendChild(style);\n  }\n\n  // Add hover logic to the sibling of method-pill element\n  const methodPill =\n    previousElement.querySelector(\".method-pill\") ||\n    previousElement.querySelector('[class*=\"method-pill\"]');\n\n  if (methodPill \u0026\u0026 methodPill.nextElementSibling) {\n    const siblingElement = methodPill.nextElementSibling;\n\n    siblingElement.addEventListener(\"mouseenter\", () =\u003e {\n      previousElement.classList.add(\"hide-gradient\");\n    });\n\n    siblingElement.addEventListener(\"mouseleave\", () =\u003e {\n      previousElement.classList.remove(\"hide-gradient\");\n    });\n  }\n}\n\n// Run when DOM is ready\nif (document.readyState === \"loading\") {\n  document.addEventListener(\"DOMContentLoaded\", addScrollGradient);\n} else {\n  addScrollGradient();\n}\n"])</script><script>self.__next_f.push([1,"5d:T4be,"])</script><script>self.__next_f.push([1,"// Get the target element - specifically the inner div with the disclaimer text\nconst targetElement = document.querySelector(\n  \"#chat-assistant-sheet \u003e div \u003e div.chat-assistant-sheet-content \u003e div \u003e div\",\n);\n\nif (targetElement) {\n  // Clear the existing content\n  targetElement.textContent = \"\";\n\n  // Create the disclaimer text\n  const disclaimerText = document.createTextNode(\n    \"This is an AI generated summary and may contain mistakes. It is not intended to give advice, including legal, financial or tax advice. It does not have access to your account information. By using this AI-assistant, you agree to the \",\n  );\n\n  // Create the link element\n  const tosLink = document.createElement(\"a\");\n  tosLink.href =\n    \"https://www.coinbase.com/legal/developer-platform/terms-of-service\";\n  tosLink.textContent = \"CDP ToS\";\n  tosLink.target = \"_blank\";\n  tosLink.rel = \"noopener noreferrer\";\n  tosLink.style.borderBottom = \"1px solid rgb(var(--primary))\";\n\n  // Add the period after the link\n  const period = document.createTextNode(\".\");\n\n  // Append all elements to the disclaimer div\n  targetElement.appendChild(disclaimerText);\n  targetElement.appendChild(tosLink);\n  targetElement.appendChild(period);\n}\n"])</script><script>self.__next_f.push([1,"5e:Te5d,"])</script><script>self.__next_f.push([1,"const HEADER_CLASS = \"nav-section-header\";\n\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  addNavSections();\n});\n\nconst dropdownObserver = new MutationObserver(function (mutations) {\n  mutations.forEach(function (mutation) {\n    if (mutation.type === \"childList\") {\n      mutation.addedNodes.forEach(function (node) {\n        if (node.nodeType === Node.ELEMENT_NODE) {\n          if (\n            (node.hasAttribute \u0026\u0026\n              node.hasAttribute(\"data-radix-popper-content-wrapper\")) ||\n            (node.querySelector \u0026\u0026\n              node.querySelector(\"[data-radix-popper-content-wrapper]\"))\n          ) {\n            setTimeout(addNavSections);\n          }\n        }\n      });\n    }\n  });\n});\n\ndropdownObserver.observe(document.body, {\n  childList: true,\n  subtree: true,\n});\n\nfunction addNavSections() {\n  const dropdown = document.querySelector(\".nav-dropdown-content\");\n  if (!dropdown) return;\n\n  const sections = [\n    {\n      firstItem: \"CDP API\",\n      header: \"Crypto infrastructure\",\n      addDivider: false,\n    },\n    {\n      firstItem: \"Coinbase Advanced Trade API\",\n      header: \"Consumer APIs\",\n      addDivider: true,\n    },\n    {\n      firstItem: \"CDP API V1\",\n      header: \"Legacy\",\n      addDivider: true,\n    },\n    {\n      firstItem: \"Coinbase Business API\",\n      header: \"Business APIs\",\n      addDivider: true,\n    },\n    {\n      firstItem: \"Coinbase Exchange API\",\n      header: \"Institutional APIs\",\n      addDivider: true,\n    },\n  ];\n\n  sections.forEach((section) =\u003e {\n    const firstItem = dropdown.querySelector(\n      `[data-dropdown-item=\"${section.firstItem}\"]`,\n    );\n    if (!firstItem) return;\n\n    const HEADER_CLASS = \"nav-section-header\";\n    const existingHeader = firstItem.previousElementSibling;\n    if (existingHeader \u0026\u0026 existingHeader.classList.contains(HEADER_CLASS)) {\n      return;\n    }\n\n    const headerElement = document.createElement(\"div\");\n    headerElement.className = HEADER_CLASS;\n    headerElement.textContent = section.header;\n\n    Object.assign(headerElement.style, {\n      fontSize: \"0.7rem\",\n      fontWeight: \"600\",\n      textTransform: \"uppercase\",\n      letterSpacing: \"0.05em\",\n      color: \"#6b7280\",\n      padding: \"12px 8px 4px 8px\",\n      marginBottom: \"4px\",\n    });\n\n    if (section.addDivider) {\n      Object.assign(headerElement.style, {\n        borderTop: \"1px solid #e5e7eb\",\n        marginTop: \"8px\",\n      });\n    }\n\n    if (\n      document.documentElement.classList.contains(\"dark\") ||\n      document.body.classList.contains(\"dark\")\n    ) {\n      headerElement.style.color = \"#9ca3af\";\n      if (section.addDivider) {\n        headerElement.style.borderTopColor = \"rgba(255, 255, 255, 0.1)\";\n      }\n    }\n\n    firstItem.parentNode.insertBefore(headerElement, firstItem);\n  });\n}\n\nconst observer = new MutationObserver(function (mutations) {\n  mutations.forEach(function (mutation) {\n    if (\n      mutation.type === \"attributes\" \u0026\u0026\n      (mutation.attributeName === \"class\" ||\n        mutation.attributeName === \"data-theme\")\n    ) {\n      updateSectionHeaderColors();\n    }\n  });\n});\n\nobserver.observe(document.documentElement, { attributes: true });\nobserver.observe(document.body, { attributes: true });\n\nfunction updateSectionHeaderColors() {\n  const headers = document.querySelectorAll(`.${HEADER_CLASS}`);\n  const isDark =\n    document.documentElement.classList.contains(\"dark\") ||\n    document.body.classList.contains(\"dark\");\n\n  headers.forEach((header) =\u003e {\n    header.style.color = isDark ? \"#9ca3af\" : \"#6b7280\";\n    if (header.style.borderTop) {\n      header.style.borderTopColor = isDark\n        ? \"rgba(255, 255, 255, 0.1)\"\n        : \"#e5e7eb\";\n    }\n  });\n}\n"])</script><script>self.__next_f.push([1,"58:[\"$\",\"$L5b\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"698cb538f9e80a68c4838f5f\",\"filePath\":\"add-scroll-gradient.js\",\"subdomain\":\"coinbase-prod\",\"__v\":0,\"content\":\"$5c\"},{\"_id\":\"698cb538f9e80a68c4838f79\",\"filePath\":\"ai-assistant-message.js\",\"subdomain\":\"coinbase-prod\",\"__v\":0,\"content\":\"$5d\"},{\"_id\":\"698cb539f9e80a68c4839b00\",\"filePath\":\"dropdowns.js\",\"subdomain\":\"coinbase-prod\",\"__v\":0,\"content\":\"$5e\"},{\"_id\":\"698cb53ef9e80a68c483d1ee\",\"subdomain\":\"coinbase-prod\",\"filePath\":\"lint-stag