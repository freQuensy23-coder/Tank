/_next/static/chunks/87bf3f796b2be4f9.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/8d0901e40ed4b058.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/b2483d01d47db298.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/5c186094c9fda2b5.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/e07fdeaa7fc096e9.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/7cf73f48f7f00160.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/d8de9e3010c1c0a2.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/b241678460c3859c.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/c7d45773caa7629c.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/ad7419efb0e48aa3.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/ac1d672f8544440f.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/79deac81143c6431.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/0e1fc6a92afa30b8.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/3ffcc95698fead4e.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/0ffd25345c17e3ee.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/c18b0a8de3827f70.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/2f482bcd3294a910.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/3d4550911741fe33.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/e7ab3f319130be21.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/67122d2cabb5f5fb.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/0dc05d97594e73a1.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\"],\"CustomCssFiles\"]\n"])</script><script>self.__next_f.push([1,"57:I[27201,[\"/mintlify-assets/_next/static/chunks/0ea0e179f06dc225.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\"],\"IconMark\"]\n4f:T7b4,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://docs.kraken.com/#organization\",\"name\":\"Kraken Developers\",\"url\":\"https://docs.kraken.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://mintcdn.com/kraken/opwCJHYUnRFWd1O3/logo/light.svg?fit=max\u0026auto=format\u0026n=opwCJHYUnRFWd1O3\u0026q=85\u0026s=6be2f97a23f9a7aa6ef071ae334cc89c\"}},{\"@type\":\"WebSite\",\"@id\":\"https://docs.kraken.com#website\",\"name\":\"Kraken Developers\",\"url\":\"https://docs.kraken.com\",\"publisher\":{\"@id\":\"https://docs.kraken.com/#organization\"}},{\"@type\":\"WebPage\",\"@id\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades#webpage\",\"url\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades\",\"name\":\"Get Recent Trades\",\"description\":\"Returns the last 1000 trades by default\",\"dateModified\":\"2026-10-06T09:51:28.957Z\",\"isPartOf\":{\"@id\":\"https://docs.kraken.com#website\"},\"breadcrumb\":{\"@id\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades#breadcrumb\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Market Data\",\"item\":\"https://docs.kraken.com/api-reference/market-data/get-server-time\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Get Recent Trades\",\"item\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades\"}]},{\"@type\":[\"TechArticle\",\"APIReference\"],\"@id\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades#apireference\",\"headline\":\"Get Recent Trades\",\"name\":\"Get Recent Trades\",\"description\":\"Returns the last 1000 trades by default\",\"url\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades\",\"mainEntityOfPage\":{\"@id\":\"https://docs.kraken.com/api-reference/market-data/get-recent-trades#webpage\"},\"dateModified\":\"2026-10-06T09:51:28.957Z\",\"publisher\":{\"@id\":\"https://docs.kraken.com/#organization\"},\"isPartOf\":{\"@id\":\"https://docs.kraken.com#website\"}}]}"])</script><script>self.__next_f.push([1,"53:T277d,"])</script><script>self.__next_f.push([1,"/* ── FONTS ────────────────────────────────────────────────────────────────\n   Loaded from Kraken's public CDN. Font face URLs in these files are relative\n   to the CDN origin so they resolve correctly via @import.\n   ─────────────────────────────────────────────────────────────────────── */\n@import url('https://assets.kraken.com/fonts/kraken.css');\n@import url('https://assets.kraken.com/fonts/celias.css');\n\n\n/* ── TYPOGRAPHY ───────────────────────────────────────────────────────── */\nhtml, body, body * {\n  font-family: var(--kp-font-sans) !important;\n  -webkit-font-smoothing: antialiased;\n}\n\nh1, h2, h3, h4 {\n  font-family: var(--kp-font-brand) !important;\n}\n.prose h1, .prose h2, .prose h3, .prose h4,\n.prose h5, .prose h6 {\n  font-family: var(--kp-font-brand) !important;\n  font-weight: 500 !important;\n}\n\nbody code, body pre, body kbd, body samp,\nbody code *, body pre *,\nbody [class*=\"code\"], body [class*=\"Code\"],\n.kp-mono, .kp-mono * {\n  font-family: var(--kp-font-mono) !important;\n}\n\n\n/* ── DESIGN TOKENS ────────────────────────────────────────────────────────\n   Single source of truth for the API Centre theme. Only tokens actually\n   referenced by snippets/* or rules below are defined here.\n   ─────────────────────────────────────────────────────────────────────── */\n:root {\n  /* Primary — pro-fe (de-purpled): black/white as the primary action color */\n  --kp-primary:            #101114;\n  --kp-primary-hover:      #2a2c33;\n\n  /* Brand accent — purple (focus rings, brand CTAs) */\n  --kp-brand:              #7132f5;\n\n  /* Typography */\n  --kp-font-sans:          'Kraken-Product', system-ui, -apple-system, sans-serif;\n  --kp-font-mono:          'Kraken-Mono', ui-monospace, monospace;\n  --kp-font-brand:         'Kraken-Brand', 'Celias', system-ui, sans-serif;\n\n  /* Surfaces */\n  --kp-bg-page:            #f6f5f9;\n  --kp-bg-card:            #ffffff;\n  --kp-bg-subtle:          rgba(104, 107, 130, 0.12);\n\n  /* Text */\n  --kp-text-heading:       #101114;\n  --kp-text-body:          #686b82;\n  --kp-text-placeholder:   #9497a9;\n  --kp-text-accent:        #101114;\n  --kp-text-meta:          #9497a9;\n\n  /* Borders */\n  --kp-border:             rgba(104, 107, 130, 0.16);\n\n  /* Terminal — CLI demo window (aliases that re-theme in dark mode) */\n  --kp-terminal-bg:        transparent;\n  --kp-terminal-text:      var(--kp-text-body);\n  --kp-terminal-heading:   var(--kp-text-heading);\n  --kp-terminal-muted:     var(--kp-text-placeholder);\n}\n\nhtml.dark {\n  --kp-primary:            #ffffff;\n  --kp-primary-hover:      #e7e7e7;\n  --kp-brand:              #8a61ff;\n\n  --kp-bg-page:            #0b0611;\n  --kp-bg-card:            #16121f;\n  --kp-bg-subtle:          rgba(255, 255, 255, 0.07);\n\n  --kp-text-heading:       #ffffff;\n  --kp-text-body:          #c6c7d2;\n  --kp-text-placeholder:   #9497a9;\n  --kp-text-accent:        #ffffff;\n  --kp-text-meta:          rgba(255, 255, 255, 0.45);\n\n  /* Match Mintlify's native dark card/table border (white/10) so custom\n     landing-page cards align with native \u003cCard\u003e outlines. */\n  --kp-border:             rgba(255, 255, 255, 0.1);\n}\n\n\n/* ── REDUCED MOTION ───────────────────────────────────────────────────── */\n@media (prefers-reduced-motion: reduce) {\n  .kp-terminal *,\n  .kp-welcome-hero * {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n\n\n/* ── MINTLIFY / MINT OVERRIDES ────────────────────────────────────────────\n   Align Mintlify's built-in doc page styling with the Pro design system.\n   WARNING: targets Mintlify internal elements; verify after upgrades. */\n\n/* Page background */\nbody {\n  background-color: var(--kp-bg-page) !important;\n}\nbody #almond-background-color {\n  background-color: var(--kp-bg-page) !important;\n}\n\n/* Doc content text — align with Pro typography colors */\n.prose {\n  --tw-prose-body: var(--kp-text-body) !important;\n  --tw-prose-headings: var(--kp-text-heading) !important;\n  --tw-prose-links: var(--kp-text-accent) !important;\n  --tw-prose-bold: var(--kp-text-heading) !important;\n  --tw-prose-code: var(--kp-text-heading) !important;\n  --tw-prose-counters: var(--kp-text-body) !important;\n  --tw-prose-bullets: var(--kp-text-placeholder) !important;\n  --tw-prose-hr: var(--kp-border) !important;\n  --tw-prose-quotes: var(--kp-text-body) !important;\n  --tw-prose-quote-borders: var(--kp-border) !important;\n  --tw-prose-th-borders: var(--kp-border) !important;\n  --tw-prose-td-borders: var(--kp-border) !important;\n}\n\n/* Sidebar text */\nnav a, nav button {\n  color: var(--kp-text-body);\n}\nnav a:hover, nav button:hover {\n  color: var(--kp-text-heading);\n}\n\n/* Navbar logo — render the wordmark at its true aspect ratio. Mintlify forces\n   h-7 (28px height); capping only the width (the art is ~6.7:1) distorts the\n   box to 150×28 and leaves vertical letterbox slack — the logo fills its width\n   but floats short of its height, reading as slightly stretched and shifting\n   sub-pixels between layouts. Fix the width and let the height follow so the\n   box always matches the SVG's ratio. */\n.nav-logo {\n  width: 150px !important;\n  height: auto !important;\n}\n\n/* Card-like containers — ResponseField, callouts, panels */\n[data-component-part=\"field-root\"] {\n  border-color: var(--kp-border) !important;\n}\n\n/* Tab buttons */\n[role=\"tablist\"] button[data-state=\"active\"] {\n  color: var(--kp-text-heading) !important;\n  border-color: var(--kp-primary) !important;\n}\n[role=\"tablist\"] button[data-state=\"inactive\"] {\n  color: var(--kp-text-placeholder) !important;\n}\n\n/* ── LANDING PAGE COMPONENTS ──────────────────────────────────────────────\n   Used by snippets/welcome-content.mdx, hero-actions.jsx,\n   product-cards.jsx, and chat-demo.jsx (the CLI terminal demo).\n   ─────────────────────────────────────────────────────────────────────── */\n\n/* Welcome hero — 2-col layout (actions + copy on left, code panel on right).\n   Suppresses Mintlify's auto-rendered eyebrow + h1 + description + page menu;\n   we render our own h1 and description inline. Frontmatter `title` and\n   `description` are kept for SEO/sidebar.\n   WARNING: targets Mintlify internal structure — verify after upgrades. */\nbody:has(.kp-welcome-hero) #header {\n  display: none !important;\n}\n\n@media (min-width: 1024px) {\n  .kp-welcome-hero {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 2rem;\n    align-items: start;\n    margin-bottom: 2.5rem;\n  }\n}\n\n.prose .kp-welcome-title {\n  font-size: 36px !important;\n  line-height: 1.15 !important;\n  letter-spacing: -0.01em;\n  margin: 0 0 1rem !important;\n}\n\n.kp-welcome-hero-code .code-group {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n}\n\n/* Filled primary button — inverts to brand-dark on light theme, brand-light\n   on dark theme. Used for the hero \"Quickstart\" CTA. */\n.prose a.kp-hero-btn-primary {\n  text-decoration: none !important;\n  border: 1px solid var(--kp-primary) !important;\n  background-color: var(--kp-primary);\n  color: var(--kp-bg-card) !important;\n}\n.prose a.kp-hero-btn-primary:hover {\n  background-color: var(--kp-primary-hover);\n  border-color: var(--kp-primary-hover) !important;\n}\nhtml.dark .prose a.kp-hero-btn-primary {\n  color: var(--kp-bg-page) !important;\n}\n\n/* Terminal demo — dark window styling with theme-aware tokens */\n.kp-terminal {\n  background: var(--kp-terminal-bg) !important;\n  border-color: var(--kp-border) !important;\n}\n.kp-terminal.kp-terminal-card {\n  background: var(--kp-bg-card) !important;\n}\n.kp-terminal .kp-term-output {\n  color: var(--kp-terminal-text);\n}\n.kp-terminal .kp-term-prompt-text {\n  color: var(--kp-terminal-heading) !important;\n}\n.kp-terminal .kp-term-cursor {\n  background: var(--kp-terminal-heading) !important;\n}\n.kp-terminal span[aria-hidden=\"true\"]:first-child {\n  color: var(--kp-terminal-muted) !important;\n}\n\n/* Terminal demo + code blocks — hide scrollbar but keep scrollable */\n.kp-term-output,\npre code {\n  scrollbar-width: none;\n}\n.kp-term-output::-webkit-scrollbar,\npre code::-webkit-scrollbar {\n  display: none;\n}\n\n/* Terminal — smaller font on narrow screens so table output fits */\n@media (max-width: 480px) {\n  .kp-term-output {\n    font-size: 11px !important;\n    padding: 12px 14px !important;\n  }\n}\n\n/* CLI install command bar */\n.kp-cli-install {\n  scrollbar-width: none;\n}\n.kp-cli-install::-webkit-scrollbar {\n  display: none;\n}\n\n.kp-cli-copy-btn {\n  transition: color 0.15s ease;\n}\n.kp-cli-install:hover .kp-cli-copy-btn {\n  color: var(--kp-text-heading) !important;\n}\n.kp-cli-install:focus-visible {\n  outline: 2px solid var(--kp-brand);\n  outline-offset: -2px;\n}\n.kp-cli-copy-btn svg {\n  transition: transform 0.15s ease;\n}\n.kp-cli-install:hover .kp-cli-copy-btn svg {\n  transform: scale(1.15);\n}\n\n/* Hide the auto-injected \"Log In\" button in the top navbar.\n   Mintlify renders this when password auth is enabled. The button class\n   is .login-link; the \"Get API key\" navbar.primary CTA is unaffected. */\n.login-link {\n  display: none !important;\n}\n"])</script><script>self.__next_f.push([1,"54:T8fa,"])</script><script>self.__next_f.push([1,"/* Tighten vertical white space across docs pages */\n\n/* Horizontal rule dividers */\nhr {\n  margin-top: 1rem !important;\n  margin-bottom: 1rem !important;\n}\n\n/* Field description — reduce gap between param header and description */\n[data-component-part=\"field-content\"] {\n  margin-top: 0.25rem !important;\n}\n\n/* Protocol banner — shared base for WS and FIX\n   Colors use Pro foundation grey scale and semantic palette */\n.api-banner {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  border: 1px solid light-dark(#e5e6ec, #353746);\n  box-shadow: 0 0 0 5px light-dark(#ffffff, #0b0611), 0 0 0 6px light-dark(#e5e6ec, #353746);\n  border-radius: 1rem;\n  padding: 0.4rem;\n  margin-bottom: 0.8rem;\n}\n\n.api-banner .api-protocol {\n  color: white;\n  font-weight: 800;\n  font-size: 12px;\n  padding: 0.1rem 0.5rem;\n  border-radius: 1rem;\n  text-transform: uppercase;\n}\n\n.api-banner .api-protocol.ws {\n  background: light-dark(#0079b4, #004e75);\n}\n\n.api-banner .api-protocol.fix {\n  background: light-dark(#a67c1d, #6f5000);\n}\n\n.api-banner .api-detail {\n  font-family: var(--kp-font-mono);\n  font-size: 14px;\n  color: light-dark(#484b5e, #9497a9);\n}\n\n.api-banner .api-tag {\n  margin-left: auto;\n  font-family: var(--kp-font-mono);\n  font-weight: 600;\n  font-size: 12px;\n  background: light-dark(#eeeff3, #292b38);\n  color: light-dark(#484b5e, #c6c7d2);\n  padding: 0.1rem 1.5rem;\n  border-radius: 0.7rem;\n}\n\n/* Sidebar tag pills — reposition to left of label */\ndiv:has(\u003e .nav-tag-pill) {\n  order: -1;\n  margin-left: 0 !important;\n  margin-right: 0.9rem !important;\n}\n\n/* Code blocks — smaller font, tighter line spacing */\npre code {\n  font-size: 12px !important;\n}\n\n[data-component-part=\"code-block-root\"],\n[data-component-part=\"code-group-tab-content\"] {\n  line-height: 1.25rem !important;\n}\n\n/* Right-side panel — flow with content instead of sticking */\n#content-side-layout {\n  position: relative !important;\n  top: auto !important;\n  height: auto !important;\n  max-height: none !important;\n}\n\n/* OpenAPI endpoint description — shrink to 16px */\n#header .prose {\n  font-size: 16px;\n}\n\n/* Metadata keyword labels inside ResponseField (One of, Default, Example, etc.) */\n.field-attr {\n  font-weight: 600;\n  font-size: 12px;\n  line-height: 16px;\n  color: light-dark(#686b82, #9497a9);\n}\n"])</script><script>self.__next_f.push([1,"4a:[\"$\",\"$L4e\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$4f\"}}],[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L50\",null,{\"pageMetadata\":\"$45:props:pageMetadata\"}]],[\"$\",\"$L51\",null,{\"pageMetadata\":\"$45:props:pageMetadata\"}],[\"$\",\"$L52\",null,{\"cssFiles\":[{\"_id\":\"6a2a4fcd15aa7c011cd0e4e1\",\"filePath\":\"custom.css\",\"subdomain\":\"kraken\",\"__v\":0,\"content\":\"$53\"},{\"_id\":\"6a2a4fcd15aa7c011cd0e511\",\"filePath\":\"global.css\",\"subdomain\":\"kraken\",\"__v\":0,\"content\":\"$54\"}]}],\"$L55\",\"$L56\"]}]\n4b:[\"$\",\"link\",\"31\",{\"rel\":\"icon\",\"href\":\"/mintlify-assets/_mintlify/favicons/kraken/WtiP_7MUCtGxw5vL/_generated/favicon-dark/favicon-32x32.png\",\"type\":\"image/png\",\"sizes\":\"32x32\",\"media\":\"(prefers-color-scheme: dark)\"}]\n4c:[\"$\",\"link\",\"32\",{\"rel\":\"shortcut icon\",\"href\":\"/mintlify-assets/_mintlify/favicons/kraken/WtiP_7MUCtGxw5vL/_generated/favicon-dark/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"$undefined\",\"media\":\"(prefers-color-scheme: dark)\"}]\n4d:[\"$\",\"$L57\",\"33\",{}]\n"])</script><script>self.__next_f.push([1,"58:I[36098,[\"/mintlify-assets/_next/static/chunks/0ea0e179f06dc225.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxy