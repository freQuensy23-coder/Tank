 _components = {\\n    p: \\\"p\\\",\\n    ..._provideComponents(),\\n    ...props.components\\n  };\\n  return _jsx(_components.p, {\\n    children: \\\"Returns the last 1000 trades by default\\\"\\n  });\\n}\\nfunction MDXContent(props = {}) {\\n  const {wrapper: MDXLayout} = {\\n    ..._provideComponents(),\\n    ...props.components\\n  };\\n  return MDXLayout ? _jsx(MDXLayout, {\\n    ...props,\\n    children: _jsx(_createMdxContent, {\\n      ...props\\n    })\\n  }) : _createMdxContent(props);\\n}\\nreturn {\\n  default: MDXContent\\n};\\n\",\"frontmatter\":{},\"scope\":{}},\"mdxExtracts\":{\"tableOfContents\":[],\"codeExamples\":{}},\"pageType\":\"$undefined\",\"panelMdxSource\":\"$undefined\",\"panelMdxSourceWithNoJs\":\"$undefined\",\"contextualStarterQuestions\":\"$undefined\",\"relatedPages\":\"$undefined\",\"relatedPagesConfig\":\"$undefined\",\"narration\":\"$undefined\"},\"children\":[\"$\",\"$L49\",null,{\"pageMetadata\":\"$45:props:pageMetadata\",\"mdxExtracts\":\"$45:props:children:props:children:props:value:mdxExtracts\",\"openApiReferenceData\":{\"operation\":{\"summary\":\"Get Recent Trades\",\"description\":\"Returns the last 1000 trades by default\\n\",\"tags\":[\"Market Data\"],\"operationId\":\"getRecentTrades\",\"security\":[],\"parameters\":[\"b4fe6656-294b-4693-b2fe-eb9897f16c35\",\"93d7d333-942e-45bd-afc3-9fcebb1a2a07\",\"0f1fe456-8207-4b10-ab85-3c3969edf864\",\"a11836cb-d543-4922-95f7-aa76ed2718ea\",\"a0b0a055-1afb-4181-b7f8-95c8adca8d41\"],\"responses\":{\"200\":\"a04c2d19-0546-418d-ae2e-869c2a2fbe8e\"},\"method\":\"get\",\"type\":\"path\",\"servers\":[\"87a9c442-141f-4578-bf9b-8e32c0200c33\"],\"path\":\"/public/Trades\",\"baseUrlOptions\":[\"https://api.kraken.com/0\"],\"title\":\"Get Recent Trades\",\"codeSamples\":[]},\"dependencies\":{\"parameters\":{\"b4fe6656-294b-4693-b2fe-eb9897f16c35\":{\"in\":\"query\",\"name\":\"pair\",\"description\":\"Asset pair to get data for\",\"required\":true,\"schema\":{\"type\":\"string\",\"isRequired\":true,\"description\":\"Asset pair to get data for\",\"uniqueKey\":\"\",\"typeLabel\":\"string\"},\"example\":\"XBTUSD\"},\"93d7d333-942e-45bd-afc3-9fcebb1a2a07\":{\"in\":\"query\",\"name\":\"assetVersion\",\"required\":false,\"schema\":{\"type\":\"integer\",\"enum\":[1],\"isRequired\":false,\"description\":\"Controls whether response keys and asset identifier fields use Kraken's internal names or display names.\\n\\n* Omitted (default): internal names are used. Asset keys use legacy `X`/`Z`-prefixed format (`XXBT`, `ZUSD`). Pair keys use the internal format (`XXBTZUSD`). Asset identifier fields (`base`, `quote`, `fee_volume_currency`) also use internal names.\\n* `assetVersion=1`: display names are used. Asset keys become their canonical display names (`BTC`, `USD`). Pair keys become the slash-separated display format (`BTC/USD`). On `/public/AssetPairs`, the `base`, `quote`, and `fee_volume_currency` fields also switch to display names.\\n\\nOnly `assetVersion=1` is currently supported. The `altname` and `wsname` fields are not affected by this parameter.\\n\",\"uniqueKey\":\"\",\"typeLabel\":\"enum\u003cinteger\u003e\"},\"description\":\"Controls whether response keys and asset identifier fields use Kraken's internal names or display names.\\n\\n* Omitted (default): internal names are used. Asset keys use legacy `X`/`Z`-prefixed format (`XXBT`, `ZUSD`). Pair keys use the internal format (`XXBTZUSD`). Asset identifier fields (`base`, `quote`, `fee_volume_currency`) also use internal names.\\n* `assetVersion=1`: display names are used. Asset keys become their canonical display names (`BTC`, `USD`). Pair keys become the slash-separated display format (`BTC/USD`). On `/public/AssetPairs`, the `base`, `quote`, and `fee_volume_currency` fields also switch to display names.\\n\\nOnly `assetVersion=1` is currently supported. The `altname` and `wsname` fields are not affected by this parameter.\\n\"},\"0f1fe456-8207-4b10-ab85-3c3969edf864\":{\"name\":\"since\",\"in\":\"query\",\"description\":\"Return trade data since given timestamp\",\"schema\":{\"type\":\"string\",\"description\":\"Return trade data since given timestamp\",\"uniqueKey\":\"\",\"typeLabel\":\"string\"},\"example\":\"1616663618\"},\"a11836cb-d543-4922-95f7-aa76ed2718ea\":{\"name\":\"count\",\"in\":\"query\",\"description\":\"Return specific number of trades, up to 1000\",\"schema\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":1000,\"default\":1000,\"description\":\"Return specific number of trades, up to 1000\",\"uniqueKey\":\"\",\"typeLabel\":\"integer\"},\"example\":2},\"a0b0a055-1afb-4181-b7f8-95c8adca8d41\":{\"name\":\"asset_class\",\"in\":\"query\",\"description\":\"This parameter is required on requests for non-crypto pairs, i.e. use `tokenized_asset` for xStocks.\",\"required\":false,\"schema\":{\"type\":\"string\",\"enum\":[\"tokenized_asset\"],\"isRequired\":false,\"description\":\"This parameter is required on requests for non-crypto pairs, i.e. use `tokenized_asset` for xStocks.\",\"uniqueKey\":\"\",\"typeLabel\":\"enum\u003cstring\u003e\"}}},\"responses\":{\"a04c2d19-0546-418d-ae2e-869c2a2fbe8e\":{\"description\":\"Trade data retrieved.\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"object\",\"additionalProperties\":{\"title\":\"TickData\",\"description\":\"Array of trade entries\\n`[\u003cprice\u003e, \u003cvolume\u003e, \u003ctime\u003e, \u003cbuy/sell\u003e, \u003cmarket/limit\u003e, \u003cmiscellaneous\u003e, \u003ctrade_id\u003e]`\\n\",\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"string\",\"title\":\"string\",\"example\":[\"1205.00000\",\"2.28253070\",1668714225.5189962,\"b\",\"l\",\"\",41557503],\"uniqueKey\":\"result.additionalProperties.items.[INDEX].items.[INDEX].oneOf.0\",\"typeLabel\":\"string\"},{\"type\":\"number\",\"title\":\"number\",\"example\":[\"1205.00000\",\"2.28253070\",1668714225.5189962,\"b\",\"l\",\"\",41557503],\"uniqueKey\":\