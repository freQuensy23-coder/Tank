urce_name\":\"The Block\",\"status\":\"ROUTED\",\"subtype\":\"releases\",\"text\":\"Kazakhstan's Astana Financial Services Authority (AFSA) approved the country's first two spot bitcoin exchange-traded funds on Wednesday, clearing products from two local asset managers to list on the Astana International Exchange (AIX), according to a notice published by the regulator. The AFSA had not included crypto funds in its published product plans, so the approval came earlier than market participants expected. The funds will hold bitcoin directly and begin trading on November 28. The issuers said they plan to seed the funds with about 1,200 BTC bought on the spot market before launch. An AFSA spokesperson confirmed the approval to The Block.\",\"title\":\"Kazakhstan's AFSA approves first spot bitcoin ETFs for AIX listing; 1,200 BTC seed\",\"url\":\"https://www.theblock.co/news/regulation/2026-10-21-kazakhstan-afsa-approves-first-spot-bitcoin-etfs-aix-421455\"},\"message\":{\"item_id\":\"ITM-01M5EP3XSA2FRWNC8906AN43ZB\",\"kind\":\"NEW_ITEM\"}}", "type": "text"}], "type": "user.message"}, "last_payload": {"item_id": "ITM-01M5EP3XSA2FRWNC8906AN43ZB", "kind": "NEW_ITEM"}, "messages": ["5ae4d4f6faf5fc45171156a365167e5c5f59aff5d1423e8cd78ecf63ab167aaf"], "missing_fields": {}, "model_id": "gpt-6.1-sol", "model_id_basis": "RESOLVED_SESSION_AGENT", "native_execution_receipts": {"sevt_-_X582AJBgsJ6WnHOXAly": {"execution_id": "sevt_req_cd03c1d664465b6ad57fc571b0037cbf1201157af205f9d45d67ca08fa085904_0", "id": "sevt_-_X582AJBgsJ6WnHOXAly", "processed_at": "2026-10-21T07:41:19.101Z", "stop_reason": {"event_ids": ["call_20b146913cb04a03a8ad2b92a223e6b9|fc_08930fa4739d99ef016ad86c9e17b88191b6309272f19187d0"], "type": "requires_action"}, "type": "session.status_idle"}, "sevt_0H2C7gKmje5OFCkaTs-yC": {"execution_id": "sevt_req_cd03c1d664465b6ad57fc571b0037cbf1201157af205f9d45d67ca08fa085904_0", "id": "sevt_0H2C7gKmje5OFCkaTs-yC", "processed_at": "2026-10-21T07:41:11.540Z", "type": "session.st